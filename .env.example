# 必填：Claude API Key，用于关键词提炼、证据摘要、生成综述
ANTHROPIC_API_KEY=sk-ant-xxxx

# 可选：Claude 模型名（默认 claude-sonnet-5）
ANTHROPIC_MODEL=claude-sonnet-5

# 可选：Semantic Scholar API Key，提升检索限速额度（不填也能跑，只是限速更低）
# 申请地址：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 可选：本地 embedding 模型（sentence-transformers），默认已设为免费本地模型
EMBEDDING_MODEL=st-multi-qa-MiniLM-L6-cos-v1

# 可选：每次任务最多用几篇论文做综述
MAX_PAPERS=6

# 可选：每个来源(arXiv/S2)搜索时最多拉取几条候选
MAX_CANDIDATES_PER_SOURCE=10

# 可选：同时最多并行处理几个任务
MAX_CONCURRENT_JOBS=2
